<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- Package metadata -->
    <PackageId>MobiMetadata</PackageId>
    <Version>1.0.0</Version>
    <Authors>Cularr</Authors>
    <Description>A .NET library for reading metadata from MOBI/AZW ebook files and extracting images including HD images from azw.res/azw6 files.</Description>
    <PackageTags>mobi;azw;azw3;kf8;kindle;ebook;metadata;epub</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Cularr/MobiMetadata</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
